# ProcessMind AI — Environment Configuration
APP_NAME="ProcessMind AI — SOP-to-Process Intelligence Agent"
APP_ENV="development"
APP_VERSION="1.0.0"
LOG_LEVEL="INFO"

# Database Configuration
# For Docker / Production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://processmind:processmind_secret@localhost:5432/processmind_db"
# For Zero-Config Local Execution (SQLite fallback when PostgreSQL is not running):
DATABASE_URL="sqlite:///./processmind.db"

# LLM Provider Configuration ("mock" for deterministic local mode without API key, or "openai")
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Rate Limiting & Bounded Execution
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RATE_LIMIT_RPM=60
LANGGRAPH_MAX_RETRIES=2
CONFIDENCE_REVIEW_THRESHOLD=0.75

# Storage Configuration
UPLOAD_STORAGE_DIR="./storage/uploads"
SAMPLE_DATA_DIR="./data/sample_sops"
GROUND_TRUTH_DIR="./data/labelled_ground_truth"

# CORS Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
